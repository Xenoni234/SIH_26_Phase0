# ---------------------------------------------------------------------------
# Copy this file to `.env` (repo root) AND/OR `backend/.env`, then fill values.
# `.env` is gitignored — never commit real secrets.
# ---------------------------------------------------------------------------

# --- RailRadar (external prototype live-data source; NOT RTIS) ---
# Get a key at https://railradar.in — free tier is 50 req/day, 10/min.
# Leave blank to run offline against recorded fixtures.
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in/v1
# Comma-separated train numbers relevant to Vasai Road, pulled sparingly & cached.
RAILRADAR_TRAIN_NUMBERS=
# Cache TTL (seconds) for RailRadar responses — protects the 50/day quota.
RAILRADAR_CACHE_TTL=300

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_USER=vasai
POSTGRES_PASSWORD=vasai
POSTGRES_DB=vasai_twin
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# Path to the canonical topology file (relative to repo root inside the container).
TOPOLOGY_PATH=/app/data/topology/vasai.yaml
